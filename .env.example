# Copy this file to .env.local for local dev only. Do not commit real keys.
# On Vercel: Project → Settings → Environment Variables → GEMINI_API_KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Latest-sheet sync (Vercel KV / Upstash Redis). Photos are never stored.
KV_REST_API_URL=
KV_REST_API_TOKEN=
